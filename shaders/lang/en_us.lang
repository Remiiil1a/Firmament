option.SELECTION_BOX=Outline style
option.SELECTION_BOX.comment=Four settings for the block selection outline: \
	Vanilla leaves it to the pack's ordinary shading, None removes it, Glow draws \
	it in a colour you pick with a halo of that colour, and RGB is Glow with the \
	colour walking round the wheel. One program draws every line the game draws - \
	the outline, the F3+B hitboxes, a structure block's bounding box - so all \
	four settings apply to each of them.

value.SELECTION_BOX.SELECTION_BOX_VANILLA=Vanilla
value.SELECTION_BOX.SELECTION_BOX_NONE=None
value.SELECTION_BOX.SELECTION_BOX_GLOW=Glow
value.SELECTION_BOX.SELECTION_BOX_RGB=RGB

option.SELECTION_GLOW_R=Glow red
option.SELECTION_GLOW_R.comment=One of the three values the Glow setting draws \
	the outline in, 0 to 255. They are read as sRGB - the number a colour picker \
	shows - so 128 looks like a mid tone rather than a fifth of full brightness. \
	They do nothing in RGB, Vanilla or None, so a change there with no effect is \
	not a fault.

option.SELECTION_GLOW_G=Glow green
option.SELECTION_GLOW_G.comment=See Glow red.

option.SELECTION_GLOW_B=Glow blue
option.SELECTION_GLOW_B.comment=See Glow red.

option.SELECTION_RGB_SPEED=RGB cycle speed
option.SELECTION_RGB_SPEED.comment=How fast the RGB setting walks round the \
	colour wheel: 1.0 is about ten seconds a turn; slower stops reading as a \
	glow, faster becomes a strobe. Only meaningful in the RGB setting.

