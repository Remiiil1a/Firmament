value.NIGHT_ATMOSPHERE.SEMI_NATURAL=Semi-natural
value.NIGHT_ATMOSPHERE.RETRO=Retro

value.DEBUG.DEBUG_NONE=None
value.DEBUG.DEBUG_GODRAYS_NOISY=Noisy godrays
value.DEBUG.DEBUG_GODRAYS_SMOOTH=Smooth godrays
value.DEBUG.DEBUG_SKYLIGHT=Sky light
value.DEBUG.DEBUG_DEPTH=Depth buffer (is distant terrain in it)

option.SCREENSPACE_SHADOWS=Screen-space shadows (distance)
option.SCREENSPACE_SHADOWS.comment=Shadows for terrain the shadow map does not \
	reach: a ray is walked from the fragment towards the sun through the depth \
	buffer, and wherever the buffer says something is in the way, that fragment is \
	shadowed.\n\n\
	The shadow map only covers a fixed distance around the player. Past it, \
	terrain - Voxy's, Distant Horizons', any of it - is lit by the sun and casts \
	none of its own, which on hilly ground is the most conspicuous thing about the \
	distance: a valley sits in full sun no matter what stands between it and the \
	sun. Working from depth instead, everything that writes depth occludes \
	everything else, terrain drawn by another mod included.\n\n\
	It is only used past that distance. Inside it the shadow map is both more \
	accurate and already paid for, so this fades in over the shadow distance \
	rather than being applied everywhere, and the same shadow is never darkened \
	twice.\n\n\
	Three limits are inherent: the ray only reaches geometry that is on screen, \
	geometry off screen takes no part, and thin things - grass, fences - are easy \
	to miss.\n\n\
	Fine noise in the distance: raise the step count, shorten the ray. A grey \
	look overall: lower the strength.

option.SSS_STRENGTH=Shadow strength
option.SSS_STRENGTH.comment=How much the distance shadows darken. It is applied \
	to the whole colour rather than to the sunlight alone, because by the time \
	this runs the two have already been added together - so a value near 1.0 takes \
	some sky light with it as well.

option.SSS_STEPS=Ray steps
option.SSS_STEPS.comment=How many steps the ray takes. More steps means finer \
	ones over the same length, which is what keeps it from slipping between two \
	pieces of terrain and leaving streaks of light behind; each step costs one \
	depth sample.

option.SSS_LENGTH=Ray length
option.SSS_LENGTH.comment=How far the ray reaches, in blocks. A valley floor \
	often sits several dozen blocks below the ridge that shadows it, so this has \
	to be generous to catch the shadow that matters most.

option.CLOUD_MULTIPLE_SCATTER=Scattering inside the cloud
option.CLOUD_MULTIPLE_SCATTER_OCTAVES=Scattering passes
option.CLOUD_MULTIPLE_SCATTER_FALLOFF=Scattering falloff
