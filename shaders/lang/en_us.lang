above say.
option.WATER_CHARACTER=Water colour
option.WATER_CHARACTER.comment=How quickly water takes different colours of \
	light away with depth, which decides whether it reads as tropical, cold or \
	neither. Cold takes the red out first, leaving deep northern blue-green; \
	Tropical keeps nearly only blue, which makes shallow warm water glow; \
	Balanced sits between.

option.WATER_ABSORPTION_METHOD=Water absorption
option.WATER_ABSORPTION_METHOD.comment=How light is absorbed by water. \
	Refraction assisted applies it through the refraction pass and falls back to \
	a sky light estimate for scenes that are entirely underwater; No absorption \
	turns it off, which to use when the water looks wrong with a resource pack or \
	mod that draws its own water.

option.DARK_UNDERWATER=Underwater darkening

value.WATER_AA.OFF=Off
value.WATER_AA.LOW=Low
value.WATER_AA.BALANCED=Balanced
value.WATER_AA.HIGH=High

value.WATER_SURFACE.BASIC=Basic
value.WATER_SURFACE.NOISE=Noise

value.WATER_CHARACTER.COLD=Cold
